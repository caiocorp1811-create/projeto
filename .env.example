# Copie para .env.local e preencha. .env.local nunca vai para o git.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# Neon > Connection Details > connection string (pooled)
DATABASE_URL=

# Gere com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=

# Login do Caio (usuário único). Gere o hash com: npm run hash-password
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
